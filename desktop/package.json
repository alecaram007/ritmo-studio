{
  "name": "ritmo-studio",
  "productName": "Ritmo Studio",
  "version": "1.4.0",
  "description": "DAW gratuita: Channel Rack, Piano Roll, Playlist e Mixer",
  "author": "Ritmo Studio",
  "license": "MIT",
  "homepage": "https://ritmostudio.app",
  "desktopName": "ritmo-studio.desktop",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-app": "node scripts/copy-app.js && node scripts/copy-engine.js",
    "start": "npm run prepare-app && electron .",
    "dist:mac": "npm run prepare-app && electron-builder --mac --arm64 --x64 --publish never",
    "dist:win": "npm run prepare-app && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run prepare-app && electron-builder --linux --x64 --publish never",
    "dist": "npm run prepare-app && electron-builder --mac --win --linux --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "app.ritmostudio.daw",
    "productName": "Ritmo Studio",
    "copyright": "Copyright © 2026 Ritmo Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "files.js",
      "i18n.js",
      "app/**/*"
    ],
    "extraResources": [
      {
        "from": "engine-bin/${os}",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterSign": "scripts/after-sign.js",
    "publish": null,
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "RitmoStudio-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Ritmo Studio usa il microfono solo se avvii una registrazione audio."
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "writeUpdateInfo": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RitmoStudio-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ritmo Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "it_IT",
        "en_US"
      ],
      "language": "1040",
      "multiLanguageInstaller": true,
      "differentialPackage": false,
      "artifactName": "RitmoStudio-${version}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Audio",
      "maintainer": "Ritmo Studio <info@ritmostudio.app>",
      "vendor": "Ritmo Studio",
      "synopsis": "DAW gratuita",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "RitmoStudio-${version}-linux-${arch}.${ext}"
    }
  }
}
